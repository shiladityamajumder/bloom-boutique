# Set the public origin before deployment, e.g. https://www.your-domain.com
SITE_ORIGIN=http://localhost:3000

# Footer social links. Defaults currently point to the platform homepages.
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/your-profile/
# NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/your-profile/
# NEXT_PUBLIC_PINTEREST_URL=https://www.pinterest.com/your-profile/
# NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@your-channel

# Local development writes submissions into .data (excluded from git).
# Production: use a persistent private volume, or configure an HTTPS webhook.
# SUBMISSIONS_DIR=/path/to/private/persistent/storage
# SUBMISSIONS_WEBHOOK_URL=https://your-form-service.example/submit
# SUBMISSIONS_WEBHOOK_TOKEN=your-private-server-token
